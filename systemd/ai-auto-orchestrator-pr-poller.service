# systemd service for LM-2nd GitHub PR polling — NOT YET INSTALLED
# v1: timer → oneshot poll every ~60s (no long-running watch process)
# Each invocation does exactly one deterministic poll via gh CLI and exits.
# No OpenAI / model calls are made while WAITING_FOR_REVIEW — cost £0.
#
# Installation (manual, after review):
#   sudo cp systemd/ai-auto-orchestrator-pr-poller.service /etc/systemd/system/
#   sudo cp systemd/ai-auto-orchestrator-pr-poller.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-auto-orchestrator-pr-poller.timer
#
# Runtime: User=ec2-user Group=ec2-user (HOME=/home/ec2-user) — uses ec2-user gh auth / opencode DB / state
# State: ~/.local/share/ai-auto-orchestrator/pr_watches.json  (/home/ec2-user/.local/share/ai-auto-orchestrator)
# Audit log: ~/.local/state/ai-auto-orchestrator/pr_poller.log  (/home/ec2-user/.local/state/ai-auto-orchestrator)
# Config: ~/.config/ai-auto-orchestrator  (/home/ec2-user/.config/ai-auto-orchestrator)
# Directories are created automatically via ExecStartPre=+/usr/bin/install -d (0755 ec2-user:ec2-user)
# Logs: journalctl -u ai-auto-orchestrator-pr-poller -f
# Timer log: systemctl list-timers ai-auto-orchestrator-pr-poller.timer

[Unit]
Description=AI Auto Orchestrator — GitHub PR review poller (oneshot poll, zero AI cost)
Documentation=https://github.com/ibettison/AI_Auto_Orchestrator/blob/feature/opencode-github-auto-continue/docs/pr-poller.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
# Use the commissioned orchestrator venv — never pass OPENAI_API_KEY to the poller.
Environment=AI_ORCHESTRATOR_VENV=/opt/ai-orchestrator/venv
# Ensure writable state/log/config directories exist under ec2-user HOME
# before mount namespacing. Runs privileged (+ prefix) to bypass
# ProtectSystem/ProtectHome for creation, then chowns to ec2-user.
ExecStartPre=+/usr/bin/install -d -o ec2-user -g ec2-user -m 0755 /home/ec2-user/.local/share/ai-auto-orchestrator /home/ec2-user/.local/state/ai-auto-orchestrator /home/ec2-user/.config/ai-auto-orchestrator
ExecStart=/opt/ai-orchestrator/venv/bin/orchestrator-pr-watch poll
# Oneshot: service exits after one poll; timer re-invokes every 60s.
# No Restart= needed — timer serializes invocations and avoids duplicates.
# Security hardening — minimal ambient credentials, no secrets in logs.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/home/ec2-user/.local/share/ai-auto-orchestrator -/home/ec2-user/.local/state/ai-auto-orchestrator -/home/ec2-user/.config/ai-auto-orchestrator -/home/ec2-user/.local/share/opencode -/home/ec2-user/.local/state/opencode -/home/ec2-user/.config/opencode
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-pr-poller
# Do not include tokens in command line or environment logging.

[Install]
WantedBy=multi-user.target
